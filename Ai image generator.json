    {
      "parameters": {
        "jsCode": "// 1. Ambil data mentah resultJson dari node sebelumnya\n// Kita cek di dua tempat (langsung atau di dalam .data) biar aman\nconst rawData = $json.data?.resultJson || $json.resultJson;\n\n// 2. Kalau datanya kosong/null, kita balikin null semua biar gak error\nif (!rawData || rawData === \"[]\") {\n  return [{\n    img1: null,\n    img2: null,\n    img3: null,\n    img4: null\n  }];\n}\n\ntry {\n  // 3. Ubah string JSON jadi objek beneran\n  const result = JSON.parse(rawData);\n\n  // 4. Ambil array URL gambarnya\n  const urls = result.resultUrls || [];\n\n  // 5. Keluarin hasilnya satu per satu\n  return [{\n    img1: urls[0] || null,\n    img2: urls[1] || null,\n    img3: urls[2] || null,\n    img4: urls[3] || null\n  }];\n\n} catch (error) {\n  // Kalau ada error pas parsing (misal datanya bukan JSON), balikin null\n  return [{\n    img1: null,\n    img2: null,\n    img3: null,\n    img4: null\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "ae681cc6-acf6-470f-8a25-2f9e6766b1f0",
      "name": "Format result"
    },
    {
      "parameters": {
        "jsCode": "// Ambil variabel dari node Format result\nconst img1 = $json.img1;\nconst img2 = $json.img2;\nconst img3 = $json.img3;\nconst img4 = $json.img4;\n\n// Masukkan ke array dan buang yang kosong (null)\nconst images = [img1, img2, img3, img4].filter(url => url !== null);\n\n// Mengirim data ke node selanjutnya dengan nama variabel yang aman\nreturn images.map((url, i) => {\n  return {\n    url: url,\n    nomor: i + 1 // Tadi 'index', sekarang ganti jadi 'nomor'\n  };\n});"
      },
